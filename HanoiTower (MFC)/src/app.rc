/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUT DIALOGEX 0, 0, 227, 52
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    ICON            IDR_MAIN,IDC_STATIC,11,13,20,20
    LTEXT           "Hanoi Tower 1.0",IDC_STATIC,45,10,57,8,SS_NOPREFIX
    LTEXT           "© 2001.  By Tolken Ahmetolla.",IDC_STATIC,45,27,98,8
    DEFPUSHBUTTON   "OK",IDOK,176,7,44,14,WS_GROUP
END

IDD_MAIN DIALOGEX 0, 0, 357, 167
STYLE DS_SETFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | 
    WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Hanoi Tower"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    EDITTEXT        IDC_EDT_COUNT,300,53,50,14,ES_AUTOHSCROLL
    CONTROL         "Spin1",IDC_SPN_COUNT,"msctls_updown32",UDS_WRAP | 
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS,339,40,
                    11,11
    DEFPUSHBUTTON   "Enjoy",IDC_BTN_MODE,300,72,50,14
    PUSHBUTTON      "Go",IDC_BTN_CONTROL,300,99,50,14,WS_DISABLED
    CONTROL         "Slider1",IDC_SLD_SPPED,"msctls_trackbar32",
                    TBS_AUTOTICKS | TBS_TOP | WS_TABSTOP,300,126,50,12
    CONTROL         302,IDC_STA_LAMP,"Static",SS_BITMAP | SS_NOTIFY,311,7,28,
                    34
    LTEXT           "",IDC_STA_BOARD,7,7,278,153,WS_BORDER | NOT WS_GROUP
    LTEXT           "Fast",IDC_STATIC,300,141,14,8
    LTEXT           "Slow",IDC_STATIC,334,141,16,8
END


