/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDB_TOOLBAR             BITMAP                  "res\\toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAIN MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                       ID_FILE_EXIT
    END
    POPUP "&Problem"
    BEGIN
        MENUITEM "&Rings...\tCtrl+R",           ID_PROB_RING
        MENUITEM SEPARATOR
        MENUITEM "&Manual\tCtrl+M",             ID_PROB_MANUAL
        MENUITEM SEPARATOR
        MENUITEM "&Start\tEnter",               32783
        MENUITEM "&Pause\tSpace",               ID_PROB_PAUSE
        MENUITEM "S&top\tEsc",                  ID_PROB_STOP
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Options...",                 ID_TOOL_OPT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",                   ID_HELP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAIN ACCELERATORS 
BEGIN
    "M",            ID_PROB_MANUAL,         VIRTKEY, CONTROL, NOINVERT
    VK_SPACE,       ID_PROB_PAUSE,          VIRTKEY, NOINVERT
    "R",            ID_PROB_RING,           VIRTKEY, CONTROL, NOINVERT
    VK_RETURN,      ID_PROB_START,          VIRTKEY, NOINVERT
    VK_ESCAPE,      ID_PROB_STOP,           VIRTKEY, NOINVERT
END


