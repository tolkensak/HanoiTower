/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAIN                ICON                    "res\\app.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUT DIALOGEX 0, 0, 220, 73
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | 
    WS_CAPTION | WS_SYSMENU
CAPTION "About Hanoi Tower"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC,"Static",SS_OWNERDRAW,10,10,35,31
    LTEXT           "Hanoi Tower 1.0",IDC_STATIC,61,10,57,8
    LTEXT           "© 2005.  By Tolken Ahmetolla.",IDC_STATIC,61,28,99,8
    DEFPUSHBUTTON   "OK",IDOK,85,49,50,14,WS_GROUP
END

IDD_OPT DIALOGEX 0, 0, 180, 161
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | 
    WS_CAPTION | WS_SYSMENU
CAPTION "Options"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Colors",IDC_STATIC,10,10,160,82
    LTEXT           "&Ring",IDC_STATIC,46,27,15,8
    CONTROL         "",IDC_STC_RING,"Static",SS_OWNERDRAW,71,24,20,14,
                    WS_EX_STATICEDGE
    PUSHBUTTON      "Choose...",IDC_BTN_RING,103,24,50,14
    LTEXT           "&Tower",IDC_STATIC,40,48,21,8
    CONTROL         "",IDC_STC_TOWER,"Static",SS_OWNERDRAW,71,45,20,14,
                    WS_EX_STATICEDGE
    PUSHBUTTON      "Choose...",IDC_BTN_TOWER,103,45,50,14
    LTEXT           "&Background",IDC_STATIC,23,69,38,8
    CONTROL         "",IDC_STC_BKGND,"Static",SS_OWNERDRAW,71,66,20,14,
                    WS_EX_STATICEDGE
    PUSHBUTTON      "Choose...",IDC_BTN_BKGND,103,66,50,14
    CONTROL         "Display t&ooltip for toolbar buttons",IDC_CHK_TIP,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,101,121,10
    CONTROL         "Display short&key in tooltip",IDC_CHK_KEY,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,29,115,96,10
    DEFPUSHBUTTON   "OK",IDOK,10,137,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,65,137,50,14
    PUSHBUTTON      "&Apply",IDC_BTN_APPLY,120,137,50,14
END

IDD_RING DIALOGEX 0, 0, 127, 59
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | 
    WS_CAPTION | WS_SYSMENU
CAPTION "Ring"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Ring Count",IDC_STATIC,19,12,36,8
    EDITTEXT        IDC_EDT_RING,66,10,40,12,ES_RIGHT | ES_AUTOHSCROLL | 
                    ES_NUMBER
    CONTROL         "",IDC_SPN_RING,"msctls_updown32",UDS_WRAP | 
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | 
                    UDS_ARROWKEYS | UDS_NOTHOUSANDS,108,10,10,14
    DEFPUSHBUTTON   "OK",IDOK,11,35,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,66,35,50,14
END


