 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "Tolken"
            VALUE "FileDescription", "Hanoi Tower Application"
            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "hanoitower.exe"
            VALUE "LegalCopyright", "© 2005.  By Tolken Ahmetolla."
            VALUE "OriginalFilename", "hanoitower.exe"
            VALUE "ProductName", "Hanoi Tower"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END


